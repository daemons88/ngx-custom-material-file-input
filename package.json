{
  "name": "library-workspace",
  "version": "22.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-library": "ng build material-file-input",
    "pack-lib": "cd dist/material-file-input && npm pack",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "install-local": "npm run build-library && npm run pack-lib && npm install dist/material-file-input/ngx-custom-material-file-input-22.0.0.tgz --legacy-peer-deps",
    "publish": "npm run build-library && npm run pack-lib && npm publish dist/material-file-input/ngx-custom-material-file-input-22.0.0.tgz --access public",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "ngx-custom-material-file-input": "file:dist/material-file-input/ngx-custom-material-file-input-22.0.0.tgz",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "~22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.5",
    "@types/jasmine": "^6.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2"
  },
  "engines": {
    "node": ">=20.11.1"
  }
}
